# 阿里云百炼配置
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.6-plus

# STT 语音识别模型
STT_MODEL=paraformer-realtime-v2

# OCR 视觉模型
OCR_MODEL=qwen-vl-max-latest

# JWT 配置
JWT_SECRET=your_jwt_secret_here_at_least_32_characters

# 服务器配置
PORT=8081
NODE_ENV=development

# CORS 配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# MySQL Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=3307
DB_USER=course_app
DB_PASS=course_app_password
DB_NAME=course_ai_tutor
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=course_ai_tutor
MYSQL_USER=course_app
MYSQL_PASSWORD=course_app_password
