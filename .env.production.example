# ============================================
# Course AI Tutor - 生产环境配置示例
# ============================================
# 使用说明:
# 1. 复制此文件为 .env.production
# 2. 替换所有占位符为实际值
# 3. 不要将 .env.production 提交到版本控制
# ============================================

# --------------------------------------------
# Backend 服务配置 (course-ai-tutor-backend)
# --------------------------------------------

# 阿里云百炼 API 配置 (必需)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.6-plus

# STT 语音识别模型
STT_MODEL=paraformer-realtime-v2

# OCR 视觉模型
OCR_MODEL=qwen-vl-max-latest

# JWT 配置 (必需 - 生产环境必须使用强密钥)
# 生成强密钥: openssl rand -base64 64
JWT_SECRET=your_strong_jwt_secret_at_least_32_characters_random

# 服务器配置
NODE_ENV=production
PORT=8081
HOST=0.0.0.0

# CORS 配置
# 多个域名用逗号分隔
ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# RAG 服务配置 (course-ai-tutor-rag)
# --------------------------------------------

# 阿里云百炼 API 配置 (必需)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Embedding 模型
EMBEDDING_MODEL=text-embedding-v3

# RAG 服务配置
PORT=8083

# --------------------------------------------
# Docker 配置
# --------------------------------------------

# 前端 API 基础 URL (构建时使用)
# Docker Compose 会自动设置,一般无需修改
VITE_API_BASE_URL=/api
